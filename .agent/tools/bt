        os.execvp("tail", ["tail", "-n", "50", "-f", LOG_PATH])
    lines = subprocess.run(
        ["tail", "-n", str(args.lines), LOG_PATH], capture_output=True, text=True
    ).stdout
    sys.stdout.write(lines)


# ------------------------------------------------- structured op commands

def _emit_result(printed, raw_json):
    """Extract the __JSON__ line, print remaining output, return parsed dict."""
    payload = None
    rest = []
    for line in printed.splitlines():
        if line.startswith("__JSON__"):
            payload = json.loads(line[len("__JSON__"):])
        else:
            rest.append(line)
    for line in rest:
        print(line)
    if payload is None:
        raise SystemExit("no __JSON__ output from session script")
    print(json.dumps(payload, indent=2 if raw_json else None, sort_keys=True))
    return payload


