# ---------------------------------------------------------------- helpers

def session_env():
    env = os.environ.copy()
    env["BT_SESSION_DIR"] = SESSION_DIR
    return env


def blender_binary():
    return (
        os.environ.get("BT_BLENDER")
        or (DEFAULT_BLENDER if os.path.exists(DEFAULT_BLENDER) else None)
        or shutil.which("blender")
        or "blender"
    )


def read_pid():
    try:
        with open(PID_FILE) as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return None


def pid_alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def detect_monitor_geometry():
    """Geometry (x, y, w, h) of the 4K monitor, else the largest connected one.

    Prefers an exact 3840x2160 output; falls back to the connected output with
    the largest pixel area; last resort is a static ultrawide at origin.
    """
    found = []
    try:
        out = subprocess.run(
            ["xrandr", "--query"], capture_output=True, text=True, timeout=5
        ).stdout
        for line in out.splitlines():
            if " connected" not in line:
                continue
            m = re.search(r"(\d+)x(\d+)\+(\d+)\+(\d+)", line)
            if m:
                w, h, x, y = map(int, m.groups())
                found.append((x, y, w, h))
    except Exception:
        pass
    if not found:
        return 0, 0, 3440, 1440

    for geo in found:  # explicit 4K wins
        if (geo[2], geo[3]) == (3840, 2160):
            return geo
    return max(found, key=lambda g: g[2] * g[3])


def parse_geometry(spec):
    m = re.match(r"(\d+)x(\d+)\+(\d+)\+(\d+)$", spec)
    if not m:
        raise SystemExit("bad --geometry (want WxH+X+Y): %s" % spec)
    x, y, w, h = map(int, m.groups())
    return x, y, w, h


def check_running(need=True):
    running = is_running()
    if need and not running:
        raise SystemExit(
            "no blender session running -- start one with: bt start"
        )
    if not need and running:
        raise SystemExit(
            "session already running (pid %s) -- use `bt restart` or `bt stop` first"
            % read_pid()
        )


def is_running():
    pid = read_pid()
    if pid and pid_alive(pid):
        return True
    # A running blender without our pid file would break session control.
    return False


# ---------------------------------------------------------------- commands

def cmd_start(args):
    check_running(need=False)
    os.makedirs(SESSION_DIR, exist_ok=True)
    for stale in ("ready", "info"):
        p = os.path.join(SESSION_DIR, stale)
        if os.path.exists(p):
            os.remove(p)

    x, y, w, h = (
        parse_geometry(args.geometry)
        if args.geometry
        else detect_monitor_geometry()
    )

    cmd = [blender_binary()]
    if args.bg:
        cmd += ["--background"]
    else:
        cmd += ["--window-geometry", str(x), str(y), str(w), str(h)]
        # -- factory startup by default: user prefs may auto-enable a stale
        #    installed copy of the addon that would collide with bt reload
        if not args.userprefs:
            cmd += ["--factory-startup"]
    cmd += ["--python", DRIVER]

    log = open(LOG_PATH, "a")
    log.write("\n===== bt start %s =====\n" % time.strftime("%F %T"))
    log.flush()
    proc = subprocess.Popen(
        cmd, stdout=log, stderr=log, env=session_env(), start_new_session=True
    )
    with open(PID_FILE, "w") as f:
        f.write(str(proc.pid))

    mode = "background" if args.bg else "gui %dx%d+%d+%d" % (w, h, x, y)
    print("starting blender (pid %d, %s)..." % (proc.pid, mode))

    deadline = time.time() + args.wait
    while time.time() < deadline:
        if proc.poll() is not None:
            raise SystemExit(
                "blender exited early (code %s) -- see %s" % (proc.returncode, LOG_PATH)
            )
        if os.path.exists(os.path.join(SESSION_DIR, "ready")):
            print("session ready. log: %s" % LOG_PATH)
            return
        time.sleep(0.2)
    raise SystemExit("session did not become ready within %ss -- see %s" % (args.wait, LOG_PATH))


def cmd_stop(args):
    pid = read_pid()
    if not pid or not pid_alive(pid):
        print("no session running")
        return
    os.kill(pid, signal.SIGTERM)
    for _ in range(50):
        if not pid_alive(pid):
            break
        time.sleep(0.1)
    else:
        print("pid %d did not exit on SIGTERM, sending SIGKILL" % pid)
        os.kill(pid, signal.SIGKILL)
    print("session stopped (pid %d)" % pid)


def cmd_restart(args):
    cmd_stop(args)
    time.sleep(0.5)
    cmd_start(args)


def cmd_status(args):
    if not is_running():
        print("stopped")
        return
    info_path = os.path.join(SESSION_DIR, "info")
    print("running (pid %s)" % read_pid())
    if os.path.exists(info_path):
        print(open(info_path).read().rstrip())


def communicate(code, timeout):
    """Send code to the session, return (exit_status, output)."""
    if not os.path.exists(os.path.join(SESSION_DIR, "ready")):
        raise SystemExit("session not ready")
    rid = str(time.time_ns())
    with open(os.path.join(SESSION_DIR, "cmd-%s.py" % rid), "w") as f:
        f.write(code)
    # touch last so the driver picks up cmd and req atomically enough
    time.sleep(0.01)
    with open(os.path.join(SESSION_DIR, "req-%s" % rid), "w") as f:
        f.write("run")

    deadline = time.time() + timeout
    resp = os.path.join(SESSION_DIR, "resp-%s" % rid)
    while time.time() < deadline:
        if os.path.exists(resp):
            with open(resp) as f:
                content = f.read()
            first, _, output = content.partition("\n")
            m = re.match(r"EXIT:(\d+)(?: DURATION:([\d.]+))?", first)
            status = int(m.group(1)) if m else 1
            dur = m.group(2)
            os.remove(resp)
            return status, output, dur
        time.sleep(0.05)
    raise SystemExit(
        "timed out after %ss waiting for the session (heavy op? retry with --timeout)"
        % timeout
    )


def cmd_exec(args):
    check_running(need=True)
    if args.code is not None:
        code = args.code if args.code.endswith("\n") else args.code + "\n"
        label = "<code>"
    elif args.path == "-":
        code = sys.stdin.read()
        label = "<stdin>"
    else:
        path = os.path.abspath(args.path)
        if not os.path.exists(path):
            # allow running snippets by bare name
            guess = os.path.join(SNIPPETS, args.path)
            if os.path.exists(guess):
                path = guess
            elif os.path.exists(guess + ".py"):
                path = guess + ".py"
            else:
                raise SystemExit("no such file: %s" % args.path)
        with open(path) as f:
            code = f.read()
        label = path

    if args.profile:
        code = (
            "import time; _t0 = time.time()\n" + code
            + "\nprint('--- %s execution: %.3fs' % ('%s', time.time() - _t0))\n"
            % label
        )

    status, output, dur = communicate(code, args.timeout)
    sys.stdout.write(output)
    if not output.endswith("\n"):
        sys.stdout.write("\n")
    print("[bt] %s %s%s" % ("FAILED" if status else "ok", label,
                            " (%ss)" % dur if dur else ""))
    sys.exit(status)


def cmd_eval(args):
    check_running(need=True)
    code = "print(repr(eval(%r)))" % args.expr
    status, output, dur = communicate(code, args.timeout)
    sys.stdout.write(output)
    if not output.endswith("\n"):
        sys.stdout.write("\n")
    sys.exit(status)


RELOAD_CODE = """\\
import importlib.util
import os
import sys

import bpy

REPO = {repo!r}
MODULE = {module!r}

# -- user prefs may auto-enable a stale installed copy at startup; disable
#    it and drop its modules so the working tree loads cleanly
prefs = bpy.context.preferences
if "building_tools" in prefs.addons:
    try:
        bpy.ops.preferences.addon_disable(module="building_tools")
    except Exception:
        pass

old = sys.modules.get(MODULE)
if old is not None and hasattr(old, "unregister"):
    try:
        old.unregister()
        print("[bt] unregistered previous addon state")
    except Exception:
        import traceback
        print("[bt] unregister FAILED:")
        traceback.print_exc()

for name in [n for n in sys.modules if n == MODULE or n.startswith(MODULE + ".")]:
    del sys.modules[name]
for name in [n for n in sys.modules if n == "btools" or n.startswith("btools.")]:
    del sys.modules[name]

# -- defensively clear any BTOOLS classes left registered by a stale copy
for tp in list(bpy.types.__dict__):
    if tp.startswith("BTOOLS_"):
        try:
            bpy.utils.unregister_class(getattr(bpy.types, tp))
        except Exception:
            pass

spec = importlib.util.spec_from_file_location(
    MODULE, os.path.join(REPO, "__init__.py"), submodule_search_locations=[REPO]
)
mod = importlib.util.module_from_spec(spec)
sys.modules[MODULE] = mod
spec.loader.exec_module(mod)
mod.register()
print("[bt] loaded %s v%s" % (MODULE, ".".join(map(str, mod.bl_info.get("version", ()))) ))
"""


def cmd_reload(args):
    check_running(need=True)
