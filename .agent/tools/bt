def deep_diff(a, b, path=""):
    """Yield human-readable differences between two parsed JSON values."""
    if type(a) is not type(b):
        yield "%s: type %s -> %s" % (path, type(a).__name__, type(b).__name__)
    elif isinstance(a, dict):
        for k in sorted(set(a) | set(b)):
            if k not in a:
                yield "%s.%s: added = %r" % (path, k, b[k])
            elif k not in b:
                yield "%s.%s: removed (was %r)" % (path, k, a[k])
            else:
                yield from deep_diff(a[k], b[k], "%s.%s" % (path, k))
    elif isinstance(a, list):
        if len(a) != len(b):
            yield "%s: list length %d -> %d" % (path, len(a), len(b))
        for i, (x, y) in enumerate(zip(a, b)):
            yield from deep_diff(x, y, "%s[%d]" % (path, i))
    elif a != b:
        yield "%s: %r -> %r" % (path, a, b)


def load_reference(out_dir):
    index_path = os.path.join(out_dir, "index.json")
    if not os.path.exists(index_path):
        return None, {}
    with open(index_path) as f:
        index = json.load(f)
    cases = {}
    for c in index["cases"]:
        rp = os.path.join(out_dir, c["id"], "result.json")
        if os.path.exists(rp):
            with open(rp) as f:
                cases[c["id"]] = json.load(f)
    return index, cases


