def cmd_reference_diff(args):
    baseline = REFERENCE_DIR
    if not os.path.exists(os.path.join(baseline, "index.json")):
        raise SystemExit(
            "no baseline at %s -- generate one first: bt reference generate" % baseline
        )

    if args.update and not args.out:
        # update-in-place: generate straight over the baseline
        reference_generate(baseline, args.filter, args.timeout)
        print("baseline updated at %s" % baseline)
        return

    tmp = os.path.abspath(args.out or os.path.join(OUT_DIR, "reference-tmp"))
    if os.path.exists(tmp):
        shutil.rmtree(tmp)
    reference_generate(tmp, args.filter, args.timeout)

    base_index, base_cases = load_reference(baseline)
    new_index, new_cases = load_reference(tmp)
    base_ids = set(base_cases) if base_index else set()
    new_ids = set(new_cases)

    os.makedirs(DIFF_DIR, exist_ok=True)
    pixel_threshold = 1280 * 1280 * 0.01  # 1% of pixels (fuzz-filtered)
    severe, visual, minor = [], [], []
    for cid in sorted(base_ids - new_ids):
        severe.append((cid, ["REMOVED"]))
    for cid in sorted(new_ids - base_ids):
        severe.append((cid, ["ADDED"]))
    for cid in sorted(base_ids & new_ids):
        diffs = [
            d for d in deep_diff(base_cases[cid], new_cases[cid])
            if ".environment" not in d
        ]
        if not diffs:
            continue

        ae = None
        views = ["image.png", "image-front.png", "image-right.png"]
        base_images = [os.path.join(baseline, cid, v) for v in views]
        new_images = [os.path.join(tmp, cid, v) for v in views]
        if all(os.path.exists(p) for p in base_images + new_images):
            try:
                ae = 0
                for view, b_img, n_img in zip(views, base_images, new_images):
                    r = subprocess.run(
                        # -- fuzz 8%: ignore AA / sub-pixel edge jitter
                        ["compare", "-metric", "AE", "-fuzz", "8%",
                         b_img, n_img, os.path.join(
                             DIFF_DIR, "%s%s-diff.png" % (cid, view.replace(".png", "")))],
                        capture_output=True, text=True, timeout=60,
                    )
                    view_ae = int(float(r.stderr.strip() or r.stdout.strip() or 0))
                    ae = max(ae, view_ae)
            except (OSError, subprocess.TimeoutExpired, ValueError):
                pass
            try:
                subprocess.run(
                    ["convert", base_images[0], new_images[0], "+append",
                     os.path.join(DIFF_DIR, cid + "-side.png")],
                    check=True, timeout=60,
                )
            except (OSError, subprocess.TimeoutExpired):
                pass

        gate_fields = (".validation.ok", ".validation.problems", ".error",
                       ".status", ".errors[0]")
        is_severe = (
            any(k in d for d in diffs for k in gate_fields)
            or "REMOVED" in diffs or "ADDED" in diffs
        )
        is_visual = ae is not None and ae > pixel_threshold
        tag = "" if ae is None else " image AE=%s px" % ae
        if is_severe:
            severe.append((cid, diffs + [tag] if tag else diffs))
        elif is_visual:
            visual.append((cid, diffs + [tag] if tag else diffs))
        else:
            minor.append((cid, diffs + [tag] if tag else diffs))

    if not (severe or visual or minor):
        print("no differences (%d cases compared)" % len(base_ids & new_ids))
        return

    for label, group in (("SEVERE (contract)", severe),
                         ("VISUAL", visual),
                         ("minor (geometry nondeterminism)", minor)):
        if not group:
            continue
        print("%s (%d):" % (label, len(group)))
        for cid, diffs in group:
            print("  %s" % cid)
            if label.startswith("SEVERE"):
                for d in diffs:
                    print("    - %s" % d)
    print("visual review material: %s" % DIFF_DIR)
    if args.update:
        shutil.rmtree(baseline)
        shutil.copytree(tmp, baseline)
        print("baseline updated at %s" % baseline)
    sys.exit(1 if (severe or visual) else 0)


# ---------------------------------------------------------------- parser

def main():
    p = argparse.ArgumentParser(
        prog="bt",
        description="Persistent Blender session toolkit for Building Tools development.",
    )
    sub = p.add_subparsers(dest="command", required=True)

    sp = sub.add_parser("start", help="start a blender session (GUI on the 4K monitor)")
    sp.add_argument("--bg", action="store_true", help="headless session (no screenshots)")
    sp.add_argument("--userprefs", action="store_true",
                    help="load user preferences instead of factory startup")
    sp.add_argument("--geometry", help="window geometry WxH+X+Y (default: auto-detect primary monitor)")
    sp.add_argument("--wait", type=int, default=90, help="seconds to wait for session ready")
    sp.set_defaults(func=cmd_start)

    sp = sub.add_parser("stop", help="stop the blender session")
    sp.set_defaults(func=cmd_stop)

    sp = sub.add_parser("restart", help="stop then start the session")
    sp.add_argument("--userprefs", action="store_true",
                    help="load user preferences instead of factory startup")
    sp.add_argument("--geometry", help="window geometry WxH+X+Y (default: auto-detect primary monitor)")
    sp.add_argument("--wait", type=int, default=90, help="seconds to wait for session ready")
    sp.set_defaults(func=cmd_restart)

    sp = sub.add_parser("status", help="show session status")
    sp.set_defaults(func=cmd_status)

    sp = sub.add_parser("exec", help="run a python file/snippet (or -c code, or -) in the session")
    sp.add_argument("path", nargs="?", help="script path, snippet name, or '-' for stdin")
    sp.add_argument("-c", "--code", help="inline python code to run")
    sp.add_argument("-t", "--timeout", type=int, default=120)
    sp.add_argument("--profile", action="store_true", help="report wall time")
    sp.set_defaults(func=cmd_exec)

    sp = sub.add_parser("eval", help="evaluate a python expression and print its repr")
    sp.add_argument("expr")
    sp.add_argument("-t", "--timeout", type=int, default=120)
    sp.set_defaults(func=cmd_eval)

    sp = sub.add_parser("reload", help="hot-reload the addon from this repo into the session")
    sp.add_argument("-t", "--timeout", type=int, default=120)
    sp.set_defaults(func=cmd_reload)

    sp = sub.add_parser("screenshot", help="save a screenshot of the blender window")
    sp.add_argument("name", nargs="?", help="screenshot name (saved under out/screenshots/)")
    sp.add_argument("-t", "--timeout", type=int, default=60)
    sp.set_defaults(func=cmd_screenshot)

    sp = sub.add_parser("log", help="show blender session log")
    sp.add_argument("-n", "--lines", type=int, default=50)
    sp.add_argument("-f", "--follow", action="store_true")
    sp.set_defaults(func=cmd_log)

    sp = sub.add_parser("api", help="run a building feature via the scriptable api")
    sp.add_argument("feature", help="floorplan|floor|roof|door|window|multigroup|balcony|stairs|fill")
    sp.add_argument("--options", help="options as JSON, e.g. '{\"type\": \"HIP\"}'")
    sp.add_argument("--object", help="target object name (default: active)")
    sp.add_argument("--faces", help="comma-separated face indices (default: all)")
    sp.add_argument("--json", action="store_true", help="pretty-print the result JSON")
    sp.add_argument("-t", "--timeout", type=int, default=120)
    sp.set_defaults(func=cmd_api)

    sp = sub.add_parser("validate", help="validate a mesh object (matgroups, geometry, normals)")
    sp.add_argument("--object", help="object name (default: active)")
    sp.add_argument("--expect", help="assertions JSON, e.g. '{\"groups\": [\"walls\"]}'")
    sp.add_argument("--geometry", action="store_true",
                    help="gate ok on geometry problems too (frame seams are common)")
    sp.add_argument("-t", "--timeout", type=int, default=60)
    sp.set_defaults(func=cmd_validate)

    sp = sub.add_parser("scenario", help="build a reusable test scenario (wall, multi_storey, curved_wall)")
    sp.add_argument("name")
    sp.add_argument("--json", action="store_true", help="pretty-print the scenario JSON")
    sp.add_argument("-t", "--timeout", type=int, default=120)
    sp.set_defaults(func=cmd_scenario)

    sp = sub.add_parser("thumbs", help="render building-preset thumbnails into btools/presets/thumbs")
    sp.add_argument("-t", "--timeout", type=int, default=900)
    sp.set_defaults(func=cmd_thumbs)

    sp = sub.add_parser("smoke", help="build all presets + validate + render; exit 1 on failure")
    sp.add_argument("--filter", help="glob filter on preset ids")
    sp.add_argument("-t", "--timeout", type=int, default=900)
    sp.set_defaults(func=cmd_smoke)

    sp = sub.add_parser("check", help="build presets + run declarative geometry checks; exit 1 on failure")
    sp.add_argument("--filter", help="glob filter on preset ids")
    sp.add_argument("--elevation", default=None,
                    choices=["front", "back", "left", "right", "top", "iso"],
                    help="also print an ASCII elevation per preset")
    sp.add_argument("--width", type=int, default=200, help="ASCII grid width")
    sp.add_argument("--height", type=int, default=100, help="ASCII grid height")
    sp.add_argument("-t", "--timeout", type=int, default=900)
    sp.set_defaults(func=cmd_check)

    sp = sub.add_parser("reference", help="golden reference corpus (JSON logs + deterministic renders)")
    ref = sp.add_subparsers(dest="reference_command", required=True)

    sp = ref.add_parser("generate", help="generate/refresh reference cases in the live session")
    sp.add_argument("--out", default=REFERENCE_DIR, help="output dir (default: .agent/reference)")
    sp.add_argument("--filter", help="glob filter on case ids, e.g. 'balcony*'")
    sp.add_argument("-t", "--timeout", type=int, default=900)
    sp.set_defaults(func=cmd_reference_generate)

    sp = ref.add_parser("diff", help="regenerate and diff against the committed baseline")
    sp.add_argument("--out", help="temp dir for the new run (default: out/reference-tmp)")
    sp.add_argument("--filter", help="glob filter on case ids")
    sp.add_argument("--update", action="store_true", help="apply the new run as the baseline")
    sp.add_argument("-t", "--timeout", type=int, default=900)
    sp.set_defaults(func=cmd_reference_diff)

    args = p.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
