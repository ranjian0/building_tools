def _stitch_composites(out_dir):
    """Stitch per-case _view_*.png panels into image.png (2x2 grid)."""
    for case_dir in sorted(os.listdir(out_dir)):
        cdir = os.path.join(out_dir, case_dir)
        if not os.path.isdir(cdir):
            continue
        panels = sorted(
            os.path.join(cdir, f)
            for f in os.listdir(cdir)
            if f.startswith("_view_") and f.endswith(".png")
        )
        if len(panels) < 2:
            continue
        out = os.path.join(cdir, "image.png")
        subprocess.run(
            ["montage"] + panels + ["-tile", "2x2", "-geometry", "+0+0", out],
            check=True, timeout=60,
        )
        for p in panels:
            os.remove(p)


