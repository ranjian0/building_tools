LOG_PATH = os.path.join(OUT_DIR, "blender.log")
PID_FILE = os.path.join(SESSION_DIR, "pid")
DRIVER = os.path.join(TOOLS_DIR, "lib", "driver.py")
SNIPPETS = os.path.join(TOOLS_DIR, "snippets")

